# Configuracion del entorno para el pipeline ETL EPN
# Duplicar como .env y modificar segun el entorno de despliegue

# Base de datos (SQLite por defecto, PostgreSQL opcional)
DATABASE_URL=sqlite:///data/epn_dwh.db
# Para PostgreSQL descomentar y ajustar:
# DATABASE_URL=postgresql+psycopg2://usuario:password@localhost:5432/epn_dw

# Configuracion de red y scraping
SCRAPER_USER_AGENT=EPN-Academic-BI-Bot/1.0 (+https://www.epn.edu.ec; contacto-academico@epn.edu.ec)
SCRAPER_TIMEOUT=15
SCRAPER_RATE_LIMIT=1.0
SCRAPER_MAX_RETRIES=4
SCRAPER_BACKOFF_FACTOR=1.5
SCRAPER_USE_CACHE=True
SCRAPER_VERIFY_SSL=False

# Nivel de registro (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
